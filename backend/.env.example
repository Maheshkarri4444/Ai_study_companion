# Copy to `.env` and fill in real values. Never commit `.env`.
# Quote any value containing `#` (e.g. PASSWORD="abc#123"): unquoted, `#` starts a comment.

NODE_ENV=development
PORT=4000
# all = API + background worker in one process · api · worker
APP_ROLE=all

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=ai_study_companion

# Sessions — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<at-least-32-random-characters>
SESSION_TTL_DAYS=7
COOKIE_NAME=asc_session
# true in production (HTTPS)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Only needed for direct (non-proxied) browser access
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
# 4 on Vercel: it rejects request bodies over 4.5 MB before they reach the API
MAX_UPLOAD_MB=20

# Admin account created on first boot (reset with `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
ADMIN_NAME=Platform Admin

# Google Gemini. Model names are configurable: free-tier availability changes, the gateway falls back in order.
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-gemini-api-key>
AI_MODEL_PRIMARY=gemini-3.6-flash
AI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
AI_MODEL_LIGHT=gemini-3.5-flash-lite
AI_MODEL_LIGHT_FALLBACKS=gemini-3.1-flash-lite,gemini-3-flash-preview
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIM=768
AI_MAX_CONCURRENCY=4
# minimal | low | medium | high (lower = faster first token)
AI_TUTOR_REASONING=minimal

# Retrieval sufficiency thresholds (cosine) and Atlas Vector Search toggle
RETRIEVAL_STRONG_SCORE=0.72
RETRIEVAL_MIN_SCORE=0.58
VECTOR_SEARCH_ENABLED=true
# Share of grounded answers checked by the LLM judge (online evaluation)
TUTOR_JUDGE_SAMPLE_RATE=0.3
# Share of generated quiz questions reviewed by the LLM judge (questions with rule warnings are always reviewed)
QUIZ_JUDGE_SAMPLE_RATE=0.2

# Background worker (runs inside the API process when APP_ROLE=all)
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000

# Vercel only (no worker process there): UptimeRobot calls GET /api/cron/tick?key=<CRON_KEY> every
# 5 minutes for the scheduled maintenance; other jobs start as soon as they are queued.
CRON_KEY=

LOG_LEVEL=info
